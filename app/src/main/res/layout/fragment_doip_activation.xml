<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:src="@drawable/ic_gmc_logo"
            android:contentDescription="GMC"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DoIP Wi-Fi Activation"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect to the vehicle&#8217;s Wi-Fi hotspot, then tap Discover. The app tunnels UDS commands over DoIP (ISO 13400) directly to K73 VCIM via the Infotainment gateway."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- Step indicators -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <TextView android:id="@+id/step1Indicator"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="1\nWi-Fi"
                android:gravity="center" android:textColor="@color/text_hint" android:textSize="11sp" />

            <TextView android:id="@+id/step2Indicator"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="2\nRoute"
                android:gravity="center" android:textColor="@color/text_hint" android:textSize="11sp" />

            <TextView android:id="@+id/step3Indicator"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="3\nVCIM"
                android:gravity="center" android:textColor="@color/text_hint" android:textSize="11sp" />

            <TextView android:id="@+id/step4Indicator"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="4\nBLE"
                android:gravity="center" android:textColor="@color/text_hint" android:textSize="11sp" />

            <TextView android:id="@+id/step5Indicator"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="5\nDone"
                android:gravity="center" android:textColor="@color/text_hint" android:textSize="11sp" />

        </LinearLayout>

        <!-- Status card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GMC.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/gmc_red"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:text="Connect your phone to the vehicle&#8217;s built-in Wi-Fi hotspot, then tap Discover Vehicle." />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary action button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_discover"
            style="@style/Widget.GMC.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Discover Vehicle on Wi-Fi"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_run_diagnostic"
            style="@style/Widget.GMC.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Diagnostic Dump (research mode)"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_export"
            style="@style/Widget.GMC.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Copy Diagnostic"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_go_to_pairing"
            style="@style/Widget.GMC.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Scan for Vehicle Now"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Activation Step Log card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/step_log_card"
            style="@style/Widget.GMC.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ACTIVATION STEPS"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/step_log_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- UDS Terminal card (visible once connected) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/terminal_card"
            style="@style/Widget.GMC.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:strokeColor="@color/gmc_red"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="UDS Terminal (DoIP)"
                    android:textColor="@color/gmc_red"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/terminal_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp" />

                <!-- Address + PDU input row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/addr_input"
                        android:layout_width="70dp"
                        android:layout_height="40dp"
                        android:hint="Addr"
                        android:text="0045"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"
                        android:background="@color/bg_elevated"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/pdu_input"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:hint="PDU e.g. 22 F1 90"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"
                        android:background="@color/bg_elevated"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_uds_send"
                        style="@style/Widget.GMC.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Send"
                        android:textSize="12sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_terminal"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Clear"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Addr = logical ECU address (hex). PDU = UDS bytes. e.g. 0045 / 10 03 (ext session), 0045 / 22 F1 90 (VIN), 0045 / 27 01 (SA seed)"
                    android:textColor="@color/text_hint"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Requires the vehicle to be in READY or ACC mode. Connect to the vehicle&#8217;s built-in Wi-Fi (not your home router). DoIP uses TCP port 13400."
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
