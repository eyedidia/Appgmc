<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:src="@drawable/ic_gmc_logo"
            android:contentDescription="GMC"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activate Digital Key"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="One-time setup required before your vehicle can connect via Bluetooth"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- Imported vehicle / no cellular notice -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GMC.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:strokeColor="@color/status_warning"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠ Imported vehicle / No OnStar signal?"
                    android:textColor="@color/status_warning"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="If OnStar's built-in SIM has no coverage (e.g. private import outside North America): create a mobile hotspot on your phone first, then connect the vehicle to it via Settings → Connectivity → WiFi. This gives the car internet so OnStar can activate."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 1: WiFi hotspot -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GMC.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="top">
                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:text="1" android:textColor="@color/gmc_red" android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" android:gravity="center"
                    android:background="@color/bg_elevated" android:layout_marginEnd="12dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Connect Vehicle to WiFi (if no OnStar signal)"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Phone: open mobile hotspot.\nVehicle: Settings → Connectivity → WiFi → connect to your hotspot.\nThis gives the car internet access."
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 2: Press OnStar button -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GMC.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="top">
                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:text="2" android:textColor="@color/gmc_red" android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" android:gravity="center"
                    android:background="@color/bg_elevated" android:layout_marginEnd="12dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Press the Blue OnStar Button"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Sit inside your vehicle and press the blue OnStar button on the overhead console. The advisor will activate your service. The free trial is sufficient."
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="If hotspot is connected, the vehicle will reach OnStar servers via WiFi"
                        android:textColor="@color/text_hint" android:textSize="12sp"
                        android:layout_marginTop="6dp" android:fontFamily="sans-serif-light" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 3: Vehicle settings -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GMC.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="top">
                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:text="3" android:textColor="@color/gmc_red" android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" android:gravity="center"
                    android:background="@color/bg_elevated" android:layout_marginEnd="12dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Open Vehicle Settings"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="On the infotainment screen:\nSettings → Vehicle → Connected Services"
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="This menu appears only after OnStar is active"
                        android:textColor="@color/text_hint" android:textSize="12sp"
                        android:layout_marginTop="6dp" android:fontFamily="sans-serif-light" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 4: Add device -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GMC.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="top">
                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:text="4" android:textColor="@color/gmc_red" android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" android:gravity="center"
                    android:background="@color/bg_elevated" android:layout_marginEnd="12dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Add Digital Key Device"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Tap Digital Key → Add a device. The vehicle will enter pairing mode and its Bluetooth will become discoverable."
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 5: Scan in app -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GMC.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:strokeColor="@color/gmc_red"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="top">
                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:text="5" android:textColor="@color/gmc_red" android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" android:gravity="center"
                    android:background="@color/bg_elevated" android:layout_marginEnd="12dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Return Here and Scan"
                        android:textColor="@color/gmc_red" android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Come back to this app while standing next to your vehicle and tap the button below."
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_go_pair"
            style="@style/Widget.GMC.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="I've done this — Scan for Vehicle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="— OR —"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_obd2_bypass"
            style="@style/Widget.GMC.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Advanced: Bypass via OBD2 Port"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YMGMC connects locally via Bluetooth after OnStar activation. Lock/unlock commands require the vehicle to accept this app's connection key."
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
