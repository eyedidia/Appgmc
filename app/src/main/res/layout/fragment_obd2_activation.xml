<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:src="@drawable/ic_gmc_logo"
            android:contentDescription="GMC"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OBD2 Activation"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bypass OnStar via the vehicle's OBD2 port. Works with ELM327 BLE adapters and Classic Bluetooth (paired) adapters."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- Step indicators -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <TextView android:id="@+id/step1Indicator"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="1\nFind"
                android:gravity="center" android:textColor="@color/text_hint" android:textSize="11sp" />

            <TextView android:id="@+id/step2Indicator"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="2\nInit"
                android:gravity="center" android:textColor="@color/text_hint" android:textSize="11sp" />

            <TextView android:id="@+id/step3Indicator"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="3\nVIN"
                android:gravity="center" android:textColor="@color/text_hint" android:textSize="11sp" />

            <TextView android:id="@+id/step4Indicator"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="4\nActivate"
                android:gravity="center" android:textColor="@color/text_hint" android:textSize="11sp" />

            <TextView android:id="@+id/step5Indicator"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="5\nDone"
                android:gravity="center" android:textColor="@color/text_hint" android:textSize="11sp" />

        </LinearLayout>

        <!-- Status card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GMC.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/gmc_red"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:text="Plug your ELM327 OBD2 adapter into the OBD2 port, then tap Scan." />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Discovered adapter list -->
        <LinearLayout
            android:id="@+id/adapters_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp" />

        <!-- Action buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_scan"
            style="@style/Widget.GMC.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Scan for OBD2 Adapter"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_show_all_ble"
            style="@style/Widget.GMC.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Show all nearby Bluetooth devices"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_proceed_vin_mismatch"
            style="@style/Widget.GMC.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Proceed Anyway (VIN mismatch)"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_run_diagnostic"
            style="@style/Widget.GMC.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Diagnostic Dump (research mode)"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_export"
            style="@style/Widget.GMC.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Copy Diagnostic"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_go_to_pairing"
            style="@style/Widget.GMC.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Scan for Vehicle Now"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- AT Command Terminal card (always visible when adapter connected) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/terminal_card"
            style="@style/Widget.GMC.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:strokeColor="@color/gmc_red"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AT / OBD2 Terminal"
                    android:textColor="@color/gmc_red"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp" />

                <!-- Terminal output (dynamically populated) -->
                <LinearLayout
                    android:id="@+id/terminal_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp" />

                <!-- Command input row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/at_input"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:hint="e.g. ATDP, 0902, 22F190"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"
                        android:background="@color/bg_elevated"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_at_send"
                        style="@style/Widget.GMC.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Send"
                        android:textSize="12sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_terminal"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Clear"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Useful commands: ATDP (protocol), ATI (version), ATRV (voltage), 0902 (VIN), 10 03 (ext session), 22 F1 B0 (read DID)"
                    android:textColor="@color/text_hint"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Works with ELM327 BLE (UUID FFF0/FFE0) and Classic Bluetooth adapters already paired in Android Settings. Search: 'ELM327 BLE v1.5' (~₪60)."
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
